# Copia aquest fitxer a .env i canvia els valors. No pugis mai .env al repositori.
HEBRA_BD=hebra.db
HEBRA_CLAU_PASSARELLA=canvia-aquesta-clau
HEBRA_USUARI_BOTIGA=botiga
HEBRA_CONTRASENYA_BOTIGA=canvia-aquesta-contrasenya
HEBRA_SAL_TIQUET=canvia-aquesta-sal
# Regla de prova (es calibren a la setmana 0 del pilot)
HEBRA_PROVA_DURADA_S=60
HEBRA_PROVA_LECTURES=5
HEBRA_MARGE_ALTA_DB=6
HEBRA_MARGE_MITJANA_DB=3
HEBRA_TANCAMENT_SESSIO_S=10
# Tauler i API v2
# En producció HEBRA_SECRET és obligatori. Genera'l amb: python -c "import secrets; print(secrets.token_urlsafe(48))"
HEBRA_ENTORN=produccio
HEBRA_SECRET=canvia-aquesta-clau-llarga-i-aleatoria
# Galeta de sessió només per HTTPS (1 en producció)
HEBRA_COOKIE_SECURE=1
# Dies que es guarden lectures agregades i sensors (0 = no s'esborra res)
HEBRA_RETENCIO_DIES=90
HEBRA_PROCESSA_CADA_MIN=5
# Carpeta del tauler compilat (per defecte, frontend/dist del repositori)
# HEBRA_FRONTEND_DIST=/opt/hebra/frontend/dist
# Shopify (només lectura), un testimoni per botiga: HEBRA_SHOPIFY_TOKEN_<id en majúscules, no alfanumèrics -> _>
# HEBRA_SHOPIFY_TOKEN_BCN_01=shpat_...
