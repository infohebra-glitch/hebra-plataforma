---
// Lo que ve el cliente en su móvil al tocar la etiqueta. Ejemplo.
import Base from '../layouts/Base.astro';
import Ficha from '../components/Ficha.astro';
import { path, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const T = {
  es: { title: 'Ficha de ejemplo', desc: 'Así es la ficha que se abre al tocar una prenda con Hebra.', bar: 'Ficha de ejemplo', what: 'Qué es esto', back: 'Volver a la web' },
  ca: { title: 'Fitxa d’exemple', desc: 'Així és la fitxa que s’obre en tocar una peça amb Hebra.', bar: 'Fitxa d’exemple', what: 'Què és això', back: 'Tornar a la web' },
  en: { title: 'Example garment page', desc: 'This is the page that opens when a garment is tapped with Hebra.', bar: 'Example garment page', what: 'What is this', back: 'Back to the website' },
}[lang];
---
<Base title={T.title} lang={lang} route="/p/demo/" description={T.desc} bare>
  <div class="demo">
    <nav class="demo-bar" aria-label={T.bar}>
      <a class="demo-back" href={path(lang, '/')}><span aria-hidden="true">←</span> {T.back}</a>
      <span class="demo-label">{T.bar}</span>
      <a href={path(lang, '/ficha/')}>{T.what}</a>
    </nav>
    <Ficha lang={lang} />
  </div>
</Base>
<style>
  .demo { min-height: 100svh; padding-top: 3rem; background: #E9ECF0; display: grid; justify-items: center; align-content: start; }
  .demo :global(.ficha) { width: min(100%, 480px); box-shadow: 0 0 0 1px rgba(18,38,63,.06), 0 30px 60px -30px rgba(18,38,63,.25); }
  .demo-bar { position: fixed; top: 0; left: 50%; translate: -50% 0; z-index: 50; width: min(100%, 480px); box-sizing: border-box; margin: 0; display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: .8rem 1.1rem; font-size: .82rem; color: var(--tinta-2); background: #fff; border-bottom: 1px solid #EEF0F3; }
  .demo-bar a { color: var(--on-light); font-weight: 600; text-decoration: none; }
  .demo-back { display: inline-flex; gap: .4rem; align-items: center; }
  .demo-label { opacity: .7; }
  @media (max-width: 380px) { .demo-label { display: none; } }
</style>
