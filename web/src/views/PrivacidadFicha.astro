---
// Generat a partir de /mnt/project-files/web/legal/textos-legals-*.md (no editar a mà: canviar el markdown i regenerar).
import Legal from '../components/Legal.astro';
import { mainEmail, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const T = {
 "es": {
  "title": "Privacidad de la ficha",
  "description": "Qué se registra cuando acercas el móvil a la etiqueta de una prenda, y qué no.",
  "html": "<p class=\"quiet\">Última actualización: <span class=\"pend\">[fecha de publicación]</span></p>\n<h2>Qué pasa cuando acercas el móvil a la etiqueta</h2>\n<p>El móvil lee la etiqueta de la prenda y abre esta ficha en el navegador. <strong>No hace falta instalar ninguna aplicación, ni registrarse, ni dar ningún dato.</strong></p>\n<h2>Qué registramos</h2>\n<ul><li>Qué prenda se ha consultado (el código de la etiqueta: modelo, color, talla y número de serie).</li><li>Cuándo se ha consultado y en qué idioma.</li><li>Si la consulta se ha hecho en la tienda o más tarde (por ejemplo, en casa), sin usar tu ubicación.</li></ul>\n<p><span class=\"pend\">Nota para el equipo: confirmar con la plataforma que solo se registra esto antes de publicarlo.</span></p>\n<p>Con esto la marca sabe, por ejemplo, cuántas veces se consulta la composición de una prenda. <strong>Estos toques no se vinculan nunca a una compra, a una tarjeta, a una cuenta ni a una persona.</strong></p>\n<h2>Qué no registramos</h2>\n<ul><li>Ni tu nombre, ni tu teléfono, ni tu correo.</li><li>Ni tu ubicación GPS.</li><li>Ninguna cookie ni identificador de tu móvil.</li></ul>\n<p>Como cualquier web, el servidor registra durante unos días la dirección IP y el navegador por motivos de seguridad. No los usamos para identificarte.</p>\n<h2>Quién es responsable</h2>\n<p>La información de la prenda (composición, origen, cuidado) la facilita <strong><span class=\"pend\">[MARCA]</span></strong>. La ficha la sirve Hebra por encargo de la marca. Si quieres ejercer tus derechos o tienes dudas, escribe a __EMAIL__ o a la marca. Más información en la <a class=\"textlink\" href=\"/privacidad/\">Política de privacidad</a>.</p>"
 },
 "ca": {
  "title": "Privacitat de la fitxa",
  "description": "Què es registra quan acostes el mòbil a l’etiqueta d’una peça, i què no.",
  "html": "<p class=\"quiet\">Darrera actualització: <span class=\"pend\">[data de publicació]</span></p>\n<h2>Què passa quan acostes el mòbil a l'etiqueta</h2>\n<p>El mòbil llegeix l'etiqueta de la peça i obre aquesta fitxa al navegador. <strong>No cal instal·lar cap aplicació, ni registrar-se, ni donar cap dada.</strong></p>\n<h2>Què registrem</h2>\n<ul><li>Quina peça s'ha consultat (el codi de l'etiqueta: model, color, talla i número de sèrie).</li><li>Quan s'ha consultat i des de quin idioma.</li><li>Si la consulta s'ha fet a la botiga o més tard (per exemple, a casa), sense fer servir la teva ubicació.</li></ul>\n<p><span class=\"pend\">Nota per a l'equip: confirmar amb la plataforma que només es registra això abans de publicar-ho.</span></p>\n<p>Amb això la marca sap, per exemple, quantes vegades es consulta la composició d'una peça. <strong>Aquests tocs no es lliguen mai a una compra, a una targeta, a un compte ni a una persona.</strong></p>\n<h2>Què no registrem</h2>\n<ul><li>Ni el teu nom, ni el teu telèfon, ni el teu correu.</li><li>Ni la teva ubicació GPS.</li><li>Cap galeta ni identificador del teu mòbil.</li></ul>\n<p>Com qualsevol web, el servidor registra durant uns dies l'adreça IP i el navegador per motius de seguretat. No els fem servir per identificar-te.</p>\n<h2>Qui és responsable</h2>\n<p>La informació de la peça (composició, origen, cura) la dona <strong><span class=\"pend\">[MARCA]</span></strong>. La fitxa la serveix Hebra per encàrrec de la marca. Si vols exercir els teus drets o tens dubtes, escriu a __EMAIL__ o a la marca. Més informació a la <a class=\"textlink\" href=\"/ca/privacidad/\">Política de privacitat</a>.</p>"
 },
 "en": {
  "title": "Garment page privacy",
  "description": "What is recorded when you hold your phone to a garment label, and what is not.",
  "html": "<p class=\"quiet\">Last updated: <span class=\"pend\">[publication date]</span></p>\n<h2>What happens when you hold your phone to the label</h2>\n<p>Your phone reads the garment's label and opens this page in the browser. <strong>No app, no sign-up and no personal details needed.</strong></p>\n<h2>What we record</h2>\n<ul><li>Which garment was viewed (the label code: style, colour, size and serial number).</li><li>When it was viewed and in which language.</li><li>Whether it was viewed in the store or later (for example, at home), without using your location.</li></ul>\n<p><span class=\"pend\">Note for the team: confirm with the platform that only this is recorded before publishing.</span></p>\n<p>This tells the brand, for example, how often people check a garment's composition. <strong>These taps are never linked to a purchase, a card, an account or a person.</strong></p>\n<h2>What we do not record</h2>\n<ul><li>Your name, phone number or email.</li><li>Your GPS location.</li><li>Any cookie or identifier from your phone.</li></ul>\n<p>Like any website, the server logs the IP address and browser for a few days for security. We do not use them to identify you.</p>\n<h2>Who is responsible</h2>\n<p>The garment information (composition, origin, care) is provided by <strong><span class=\"pend\">[BRAND]</span></strong>. Hebra serves the page on the brand's behalf. To exercise your rights or ask questions, write to __EMAIL__ or to the brand. More in the <a class=\"textlink\" href=\"/en/privacidad/\">Privacy policy</a>.</p>"
 }
} as const;
const email = `<a class="textlink" href="mailto:${mainEmail}">${mainEmail}</a>`;
const body = T[lang].html.replaceAll('__EMAIL__', email);
---
<Legal lang={lang} route="/privacidad-ficha/" title={T[lang].title} description={T[lang].description}>
  <Fragment set:html={body} />
</Legal>
