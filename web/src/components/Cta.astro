---
// Cierre de página: un orbe de luz del color del idioma que sube con el scroll.
import { ui, path, type Lang } from '../i18n';
interface Props { lang?: Lang; title?: string; text?: string }
const { lang = 'es' } = Astro.props;
const t = ui[lang];
const title = Astro.props.title ?? t.ctaTitle;
const text = Astro.props.text ?? t.ctaText;
---
<section class="cta" data-orb-scope>
  <div class="cta-orb" data-orb aria-hidden="true"></div>
  <div class="wrap cta-in">
    <h2 data-lines set:html={title} />
    <p class="lead" data-reveal>{text}</p>
    <div class="actions" data-reveal>
      <a class="btn" href={path(lang, '/contacto/?motivo=demo')} data-magnetic>{t.demo}</a>
      <a class="btn ghost" href={path(lang, '/ficha/')}>{t.ctaSecondary}</a>
    </div>
  </div>
</section>

<style>
  .cta { position: relative; overflow: hidden; background: var(--ink); color: var(--on-dark); padding: clamp(7rem, 16vw, 13rem) 0 clamp(6rem, 12vw, 10rem); text-align: center; isolation: isolate; }
  .cta-orb { position: absolute; z-index: -1; left: 50%; bottom: -78%; width: max(150vw, 1500px); aspect-ratio: 1; translate: -50% 0; border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--tint) 75%, #fff) 0%, var(--glow) 32%, color-mix(in srgb, var(--glow) 35%, transparent) 58%, transparent 72%); }
  .cta-in { display: grid; justify-items: center; }
  .cta h2 { margin: 0; font-size: clamp(3rem, 1.6rem + 6vw, 8.5rem); line-height: .92; letter-spacing: -0.06em; max-width: 12ch; }
  .cta .lead { margin: 2rem auto 0; color: var(--on-dark); opacity: .82; }
  .cta .actions { justify-content: center; }
  .cta .btn { background: var(--on-dark); color: var(--ink); border-color: var(--on-dark); }
  .cta .btn::before { background: var(--ink); }
  .cta .btn:hover { color: #fff; border-color: var(--ink); }
  .cta .btn.ghost { background: transparent; color: var(--on-dark); border-color: color-mix(in srgb, var(--on-dark) 45%, transparent); }
</style>
