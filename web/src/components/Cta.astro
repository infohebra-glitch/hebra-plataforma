---
interface Props { title?: string; text?: string }
const {
  title = 'Hablemos de tu marca.',
  text = 'En media hora te enseñamos la etiqueta, la ficha y los datos con prendas reales. Y vemos juntos por dónde empezar en tu tienda.',
} = Astro.props;
---
<section class="band cta">
  <div class="wrap cta-in">
    <h2 data-reveal>{title}</h2>
    <div data-reveal>
      <p class="lead">{text}</p>
      <div class="actions">
        <a class="btn" href="/contacto/?motivo=demo">Pedir una demo</a>
        <a class="btn ghost" href="/ficha/">Ver la ficha</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta { border-top: 1px solid var(--linea); }
  .cta-in { display: grid; gap: 2rem; }
  @media (min-width: 900px) { .cta-in { grid-template-columns: 1fr 1fr; align-items: end; } }
  .cta h2 { margin: 0; max-width: 14ch; }
</style>
