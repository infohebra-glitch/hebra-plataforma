---
// Abanico de los nueve datos: se arrastra, se pasa con las flechas o se toca una carta para traerla delante.
import { cards } from '../data/cards';
import type { Lang } from '../i18n';
interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props;
const t = cards[lang];
const L = {
  es: { prev: 'Dato anterior', next: 'Dato siguiente', drag: 'Arrastra', of: 'de' },
  ca: { prev: 'Dada anterior', next: 'Dada següent', drag: 'Arrossega', of: 'de' },
  en: { prev: 'Previous', next: 'Next', drag: 'Drag', of: 'of' },
}[lang];
---
<div class="fan" data-fan data-cursor-label={L.drag}>
  <div class="fan-stage" data-fan-stage>
    {t.cards.map((c, i) => (
      <article class="fan-card" data-fan-card aria-hidden={i === 0 ? 'false' : 'true'}>
        <p class="fan-k">{c.k}</p>
        <p class="fan-v">{c.v}</p>
        <p class="fan-d">{c.d}</p>
        <p class="fan-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
      </article>
    ))}
  </div>
  <div class="fan-foot">
    <p class="fan-back" aria-live="polite"><span>{t.turn}</span><b data-fan-back>{t.cards[0].back}</b></p>
    <div class="fan-ctrl">
      <button type="button" data-fan-prev aria-label={L.prev}><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.6" /></svg></button>
      <span class="fan-count"><b data-fan-now>1</b> {L.of} {t.cards.length}</span>
      <button type="button" data-fan-next aria-label={L.next}><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.6" /></svg></button>
    </div>
  </div>
  <script type="application/json" data-fan-data set:html={JSON.stringify(t.cards.map((c) => c.back))} />
</div>

<style>
  .fan { position: relative; overflow-x: clip; overflow-y: visible; padding: 1rem 0; }
  .fan-stage { position: relative; height: clamp(360px, 52vw, 470px); touch-action: pan-y; user-select: none; }
  .fan-card {
    position: absolute; left: 50%; top: 0; width: min(330px, 74vw); height: 100%; margin-left: calc(min(330px, 74vw) / -2);
    display: flex; flex-direction: column; padding: 1.6rem 1.6rem 1.4rem; border-radius: var(--radius);
    background: var(--paper); color: var(--on-light); box-shadow: 0 40px 70px -40px rgba(0,0,0,.55), 0 0 0 1px var(--rule-light);
    transform-origin: 50% 120%; cursor: pointer; will-change: transform;
  }
  .fan-card[aria-hidden='false'] { cursor: grab; }
  .fan-k { font-weight: 560; margin: 0; }
  .fan-v { font: 300 clamp(4rem, 3rem + 4vw, 6.2rem)/.95 var(--serif); font-variation-settings: 'opsz' 144, 'SOFT' 100; letter-spacing: -0.05em; color: var(--deep); margin: auto 0 .8rem; font-variant-numeric: tabular-nums; }
  .fan-d { color: var(--on-light-2); margin: 0; font-size: .95rem; line-height: 1.45; }
  .fan-n { position: absolute; top: 1.5rem; right: 1.6rem; margin: 0; font-size: .8rem; color: var(--on-light-2); font-variant-numeric: tabular-nums; }
  .fan-foot { display: grid; gap: 1.5rem; margin-top: 2.5rem; align-items: end; }
  @media (min-width: 820px) { .fan-foot { grid-template-columns: 1fr auto; } }
  .fan-back { margin: 0; max-width: 40ch; }
  .fan-back span { display: block; font-size: var(--step--1); opacity: .7; margin-bottom: .4rem; }
  .fan-back b { font: 300 italic var(--step-2)/1.15 var(--serif); letter-spacing: -0.03em; font-variation-settings: 'opsz' 96; }
  .fan-ctrl { display: flex; align-items: center; gap: 1rem; }
  .fan-ctrl button { width: 52px; height: 52px; border-radius: 50%; border: 1px solid currentColor; background: none; color: inherit; display: grid; place-items: center; cursor: pointer; opacity: .8; transition: opacity .3s, background .4s var(--ease), color .4s; }
  .fan-ctrl button:hover { opacity: 1; background: #fff; color: var(--ink); border-color: #fff; }
  .fan-count { font-size: var(--step--1); font-variant-numeric: tabular-nums; min-width: 4.5em; text-align: center; }
</style>
