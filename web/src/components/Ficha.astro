---
// La ficha que se abre al tocar la prenda con el móvil. Ejemplo ilustrativo.
interface Props { compact?: boolean; interactive?: boolean }
const { compact = false, interactive = true } = Astro.props;
const sizes = [
  { s: 'S', ok: true }, { s: 'M', ok: true, cur: true }, { s: 'L', ok: false }, { s: 'XL', ok: true },
];
const why = ['Talla', 'Corte', 'Precio', 'Color', 'Calidad'];
const chain = [
  { k: 'Fibra', v: 'Lino', where: 'Normandía, Francia' },
  { k: 'Hilado y tejido', v: 'Tela de lino lavado', where: 'Biella, Italia' },
  { k: 'Tinte y acabado', v: 'Teñido en pieza', where: 'Biella, Italia' },
  { k: 'Confección', v: 'Cosida a mano', where: 'Guimarães, Portugal' },
];
---
<article class:list={['ficha', { compact }]} data-ficha={interactive ? '' : undefined}>
  <div class="fi-img">
    <span class="fi-brand">Tu marca</span>
    <img src="/img/camisa-render.png" alt="Camisa de lino lavado, blanca" width="520" height="520" loading="lazy" />
    <span class="fi-nfc"><svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M7 8.5a6 6 0 0 1 0 7M10.5 6a10 10 0 0 1 0 12M14 3.5a14 14 0 0 1 0 17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg> Prenda auténtica</span>
  </div>

  <header class="fi-head">
    <h2 class="fi-name">Camisa de lino lavado</h2>
    <p class="fi-meta"><span>69 €</span><span>Ref. 2041 · Talla M</span></p>
    <ul class="fi-tags">
      <li>Lino 100 %</li><li>Confección en Portugal</li><li>4 de 4 etapas conocidas</li>
    </ul>
  </header>

  {!compact && (
    <section class="fi-block fi-cabina">
      <div class="fi-cab-head"><h3>¿Te pruebo otra talla?</h3><span class="fi-badge">Cabina 2</span></div>
      <div class="fi-sizes" role="group" aria-label="Elegir talla">
        {sizes.map((z) => (
          <button type="button" data-size={z.s} aria-pressed="false" class:list={[{ cur: z.cur, out: !z.ok }]} aria-label={z.ok ? `Talla ${z.s}` : `Talla ${z.s}, sin stock en tienda`}>
            {z.s}{!z.ok && <small>avisar</small>}
          </button>
        ))}
      </div>
      <p class="fi-msg" data-size-msg aria-live="polite"></p>
    </section>
  )}

  <section class="fi-block">
    <h3>De dónde viene</h3>
    <ol class="fi-chain">
      {chain.map((c) => (
        <li><span class="dot" aria-hidden="true"></span><b>{c.k}</b><span>{c.v}</span><em>{c.where}</em></li>
      ))}
    </ol>
  </section>

  <section class="fi-block">
    <h3>Cuidado</h3>
    <ul class="fi-care">
      <li><svg viewBox="0 0 40 32" aria-hidden="true"><path d="M3 8h34l-4 20H7z M3 8c4 4 8 4 11 0 3 4 8 4 11 0 3 4 8 4 12 0" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><text x="20" y="24" text-anchor="middle" font-size="10" font-weight="700" fill="currentColor">30</text></svg>30 °C</li>
      <li><svg viewBox="0 0 40 32" aria-hidden="true"><rect x="7" y="4" width="26" height="24" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="20" cy="16" r="8" fill="none" stroke="currentColor" stroke-width="2"/><path d="M6 3l28 26M34 3L6 29" stroke="currentColor" stroke-width="2"/></svg>Sin secadora</li>
      <li><svg viewBox="0 0 40 32" aria-hidden="true"><path d="M6 24h28c0-8-5-14-14-14h-6l-2 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><circle cx="17" cy="19" r="1.6" fill="currentColor"/><circle cx="23" cy="19" r="1.6" fill="currentColor"/></svg>Plancha media</li>
      <li><svg viewBox="0 0 40 32" aria-hidden="true"><path d="M20 4L35 28H5z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M6 3l28 26M34 3L6 29" stroke="currentColor" stroke-width="2"/></svg>Sin lejía</li>
    </ul>
  </section>

  {!compact && (
    <section class="fi-block fi-cabina">
      <h3>¿No te la llevas? Dinos por qué</h3>
      <div class="fi-chips" role="group" aria-label="Motivo">
        {why.map((w) => <button type="button" data-why={w} aria-pressed="false">{w}</button>)}
      </div>
      <p class="fi-msg" data-why-msg aria-live="polite"></p>
    </section>
  )}

  <footer class="fi-foot">
    <span>CA · <b>ES</b> · FR · EN</span>
    <span>con Hebra</span>
  </footer>
</article>

<style>
  .ficha { background: #fff; color: var(--tinta); font-size: .9rem; line-height: 1.4; width: 100%; }
  .fi-img { position: relative; background: linear-gradient(180deg, #EEF1F5, #E4E8EE); aspect-ratio: 1 / .82; display: grid; place-items: center; overflow: hidden; }
  .fi-img img { width: 82%; height: auto; filter: drop-shadow(0 18px 18px rgba(18,38,63,.18)); }
  .fi-brand { position: absolute; top: .8rem; left: .9rem; font: 500 .95rem/1 var(--serif); color: var(--blau); letter-spacing: .01em; }
  .fi-nfc { position: absolute; bottom: .7rem; left: .8rem; display: inline-flex; align-items: center; gap: .3rem; font-size: .72rem; font-weight: 600; color: var(--blau); background: rgba(255,255,255,.85); backdrop-filter: blur(6px); padding: .3rem .55rem; border-radius: 999px; }
  .fi-head { padding: 1rem 1.1rem .9rem; }
  .fi-name { font: 400 1.45rem/1.1 var(--serif); font-variation-settings: 'opsz' 48; color: var(--blau); margin: 0; letter-spacing: -0.01em; }
  .fi-meta { display: flex; justify-content: space-between; margin: .35rem 0 .8rem; color: var(--tinta-2); font-size: .82rem; }
  .fi-meta span:first-child { color: var(--tinta); font-weight: 600; font-size: .95rem; }
  .fi-tags { list-style: none; display: flex; flex-wrap: wrap; gap: .35rem; margin: 0; padding: 0; }
  .fi-tags li { font-size: .72rem; font-weight: 600; color: var(--blau); background: #EAF0F7; padding: .3rem .55rem; border-radius: 999px; }
  .fi-block { padding: .95rem 1.1rem; border-top: 8px solid #F3F4F6; }
  .fi-block h3 { font: 600 .86rem/1.3 var(--sans); color: var(--tinta); margin: 0 0 .7rem; letter-spacing: 0; }
  .fi-cab-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: .7rem; }
  .fi-cab-head h3 { margin: 0; }
  .fi-badge { font-size: .7rem; font-weight: 700; color: #fff; background: var(--grana); padding: .25rem .5rem; border-radius: 999px; }
  .fi-sizes { display: grid; grid-template-columns: repeat(4, 1fr); gap: .4rem; }
  .fi-sizes button { position: relative; font: 600 .95rem/1 var(--sans); height: 2.8rem; border-radius: 10px; border: 1.5px solid #D5DBE3; background: #fff; color: var(--tinta); cursor: pointer; display: grid; place-content: center; gap: .15rem; }
  .fi-sizes button.cur { border-color: var(--blau); }
  .fi-sizes button.cur::after { content: 'la tuya'; position: absolute; top: -.55rem; left: 50%; transform: translateX(-50%); font-size: .58rem; font-weight: 700; background: var(--blau); color: #fff; padding: .1rem .35rem; border-radius: 999px; }
  .fi-sizes button.out { border-style: dashed; color: var(--tinta-2); }
  .fi-sizes small { font-size: .58rem; font-weight: 600; color: var(--grana); }
  .fi-sizes button[aria-pressed='true'] { background: var(--blau); color: #fff; border-color: var(--blau); }
  .fi-sizes button[aria-pressed='true'] small { color: #fff; }
  .fi-chain { list-style: none; margin: 0; padding: 0; position: relative; }
  .fi-chain::before { content: ''; position: absolute; left: 5px; top: 8px; bottom: 8px; width: 2px; background: linear-gradient(var(--grana), var(--blau)); border-radius: 2px; }
  .fi-chain li { position: relative; display: grid; grid-template-columns: 1fr auto; padding: 0 0 .75rem 1.4rem; }
  .fi-chain li:last-child { padding-bottom: 0; }
  .fi-chain .dot { position: absolute; left: 0; top: .2rem; width: 12px; height: 12px; border-radius: 50%; background: #fff; border: 2.5px solid var(--grana); }
  .fi-chain li:last-child .dot { border-color: var(--blau); background: var(--blau); }
  .fi-chain b { grid-column: 1 / -1; font-size: .7rem; font-weight: 600; color: var(--tinta-2); }
  .fi-chain span { font-weight: 600; }
  .fi-chain em { font-style: normal; color: var(--tinta-2); font-size: .8rem; text-align: right; }
  .fi-care { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: .3rem; text-align: center; font-size: .68rem; color: var(--tinta-2); }
  .fi-care svg { width: 34px; height: 28px; margin: 0 auto .3rem; color: var(--blau); }
  .fi-chips { display: flex; flex-wrap: wrap; gap: .4rem; }
  .fi-chips button { font: 600 .82rem/1 var(--sans); padding: .6rem .8rem; border-radius: 999px; border: 1.5px solid #D5DBE3; background: #fff; color: var(--tinta); cursor: pointer; }
  .fi-chips button[aria-pressed='true'] { background: var(--grana); color: #fff; border-color: var(--grana); }
  .fi-msg { min-height: 1.2em; margin: .55rem 0 0; font-size: .78rem; color: var(--grana); font-weight: 500; }
  .fi-msg:empty { display: none; }
  .fi-foot { display: flex; justify-content: space-between; padding: .8rem 1.1rem 1rem; font-size: .7rem; color: var(--tinta-2); border-top: 8px solid #F3F4F6; }
  .fi-foot b { color: var(--blau); }
  :global(.en-casa) .fi-cabina { display: none; }
  button:focus-visible { outline: 2px solid var(--grana); outline-offset: 2px; }
</style>
