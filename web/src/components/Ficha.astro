---
// La ficha que se abre al tocar la prenda con el móvil. Ejemplo ilustrativo.
import type { Lang } from '../i18n';
interface Props { compact?: boolean; interactive?: boolean; lang?: Lang }
const { compact = false, interactive = true, lang = 'es' } = Astro.props;
const sizes = [
  { s: 'S', ok: true }, { s: 'M', ok: true, cur: true }, { s: 'L', ok: false }, { s: 'XL', ok: true },
];
const T = {
  es: {
    brand: 'Tu marca', alt: 'Camiseta básica de algodón, blanca', auth: 'Prenda auténtica',
    name: 'Camiseta básica de algodón', ref: 'Ref. 2041 · Talla M',
    tags: ['Algodón orgánico 100 %', 'Confección en Portugal', '4 de 4 etapas conocidas'],
    other: '¿Te traigo otra talla?', cab: 'Cabina 2', yours: 'la tuya', notify: 'avisar', sizesLabel: 'Elegir talla', outLabel: 'sin stock en tienda',
    from: 'De dónde viene', care: 'Cuidado', careItems: ['30 °C', 'Sin secadora', 'Plancha media', 'Sin lejía'],
    whyH: '¿No te la llevas? Dinos por qué', whyLabel: 'Motivo', why: ['Talla', 'Corte', 'Precio', 'Color', 'Calidad'],
    sizeMsg: 'Hecho. Te llevamos la {s} a la cabina 2.', outMsg: 'La {s} no está en tienda. Te avisamos cuando llegue.', whyMsg: 'Gracias. No guardamos quién eres, solo el motivo.',
    chain: [
      { k: 'Fibra', v: 'Algodón orgánico', where: 'Esmirna, Turquía' },
      { k: 'Hilado y tejido', v: 'Punto jersey 180 g', where: 'Barcelos, Portugal' },
      { k: 'Tinte y acabado', v: 'Teñido en prenda', where: 'Barcelos, Portugal' },
      { k: 'Confección', v: 'Cosida y rematada', where: 'Guimarães, Portugal' },
    ],
    by: 'con Hebra',
  },
  ca: {
    brand: 'La teva marca', alt: 'Samarreta bàsica de cotó, blanca', auth: 'Peça autèntica',
    name: 'Samarreta bàsica de cotó', ref: 'Ref. 2041 · Talla M',
    tags: ['Cotó orgànic 100 %', 'Confecció a Portugal', '4 de 4 etapes conegudes'],
    other: 'T’atanso una altra talla?', cab: 'Cabina 2', yours: 'la teva', notify: 'avisar', sizesLabel: 'Triar talla', outLabel: 'sense estoc a la botiga',
    from: 'D’on ve', care: 'Cura', careItems: ['30 °C', 'Sense assecadora', 'Planxa mitjana', 'Sense lleixiu'],
    whyH: 'No te l’endus? Digues-nos per què', whyLabel: 'Motiu', why: ['Talla', 'Tall', 'Preu', 'Color', 'Qualitat'],
    sizeMsg: 'Fet. Et portem la {s} a la cabina 2.', outMsg: 'La {s} no és a la botiga. T’avisem quan arribi.', whyMsg: 'Gràcies. No guardem qui ets, només el motiu.',
    chain: [
      { k: 'Fibra', v: 'Cotó orgànic', where: 'Esmirna, Turquia' },
      { k: 'Filat i teixit', v: 'Punt jersei 180 g', where: 'Barcelos, Portugal' },
      { k: 'Tint i acabat', v: 'Tenyit en peça', where: 'Barcelos, Portugal' },
      { k: 'Confecció', v: 'Cosida i rematada', where: 'Guimarães, Portugal' },
    ],
    by: 'amb Hebra',
  },
  en: {
    brand: 'Your brand', alt: 'Basic white cotton T-shirt', auth: 'Authentic garment',
    name: 'Basic cotton T-shirt', ref: 'Ref. 2041 · Size M',
    tags: ['100 % organic cotton', 'Made in Portugal', '4 of 4 stages known'],
    other: 'Shall I bring another size?', cab: 'Room 2', yours: 'yours', notify: 'notify me', sizesLabel: 'Choose a size', outLabel: 'out of stock in store',
    from: 'Where it comes from', care: 'Care', careItems: ['30 °C', 'Do not tumble dry', 'Medium iron', 'No bleach'],
    whyH: 'Not taking it? Tell us why', whyLabel: 'Reason', why: ['Size', 'Fit', 'Price', 'Colour', 'Quality'],
    sizeMsg: 'Done. We’re bringing the {s} to room 2.', outMsg: 'The {s} isn’t in store. We’ll let you know when it arrives.', whyMsg: 'Thank you. We don’t store who you are, only the reason.',
    chain: [
      { k: 'Fibre', v: 'Organic cotton', where: 'Izmir, Türkiye' },
      { k: 'Spinning and knitting', v: '180 g jersey knit', where: 'Barcelos, Portugal' },
      { k: 'Dyeing and finishing', v: 'Garment dyed', where: 'Barcelos, Portugal' },
      { k: 'Making', v: 'Sewn and finished', where: 'Guimarães, Portugal' },
    ],
    by: 'with Hebra',
  },
}[lang];
const langs = { es: 'CA · <b>ES</b> · FR · EN', ca: '<b>CA</b> · ES · FR · EN', en: 'CA · ES · FR · <b>EN</b>' }[lang];
---
<article class:list={['ficha', { compact }]} data-ficha={interactive ? '' : undefined}>
  <div class="fi-img">
    <span class="fi-brand">{T.brand}</span>
    <img src="/img/camiseta-render.png" alt={T.alt} width="520" height="520" loading="lazy" />
    <span class="fi-nfc"><svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M7 8.5a6 6 0 0 1 0 7M10.5 6a10 10 0 0 1 0 12M14 3.5a14 14 0 0 1 0 17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg> {T.auth}</span>
  </div>

  <header class="fi-head">
    <h2 class="fi-name">{T.name}</h2>
    <p class="fi-meta"><span>29 €</span><span>{T.ref}</span></p>
    <ul class="fi-tags">
      {T.tags.map((x) => <li>{x}</li>)}
    </ul>
  </header>

  {!compact && (
    <section class="fi-block fi-cabina">
      <div class="fi-cab-head"><h3>{T.other}</h3><span class="fi-badge">{T.cab}</span></div>
      <div class="fi-sizes" role="group" aria-label={T.sizesLabel}>
        {sizes.map((z) => (
          <button type="button" data-size={z.s} aria-pressed="false" class:list={[{ cur: z.cur, out: !z.ok }]} aria-label={z.ok ? z.s : `${z.s}, ${T.outLabel}`} data-ok={z.ok ? '1' : '0'}>
            {z.s}{!z.ok && <small>{T.notify}</small>}
          </button>
        ))}
      </div>
      <p class="fi-msg" data-size-msg data-ok-msg={T.sizeMsg} data-out-msg={T.outMsg} aria-live="polite"></p>
    </section>
  )}

  <section class="fi-block">
    <h3>{T.from}</h3>
    <ol class="fi-chain">
      {T.chain.map((c) => (
        <li><span class="dot" aria-hidden="true"></span><b>{c.k}</b><span>{c.v}</span><em>{c.where}</em></li>
      ))}
    </ol>
  </section>

  <section class="fi-block">
    <h3>{T.care}</h3>
    <ul class="fi-care">
      <li><svg viewBox="0 0 40 32" aria-hidden="true"><path d="M3 8h34l-4 20H7z M3 8c4 4 8 4 11 0 3 4 8 4 11 0 3 4 8 4 12 0" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><text x="20" y="24" text-anchor="middle" font-size="10" font-weight="700" fill="currentColor">30</text></svg>{T.careItems[0]}</li>
      <li><svg viewBox="0 0 40 32" aria-hidden="true"><rect x="7" y="4" width="26" height="24" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="20" cy="16" r="8" fill="none" stroke="currentColor" stroke-width="2"/><path d="M6 3l28 26M34 3L6 29" stroke="currentColor" stroke-width="2"/></svg>{T.careItems[1]}</li>
      <li><svg viewBox="0 0 40 32" aria-hidden="true"><path d="M6 24h28c0-8-5-14-14-14h-6l-2 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><circle cx="17" cy="19" r="1.6" fill="currentColor"/><circle cx="23" cy="19" r="1.6" fill="currentColor"/></svg>{T.careItems[2]}</li>
      <li><svg viewBox="0 0 40 32" aria-hidden="true"><path d="M20 4L35 28H5z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M6 3l28 26M34 3L6 29" stroke="currentColor" stroke-width="2"/></svg>{T.careItems[3]}</li>
    </ul>
  </section>

  {!compact && (
    <section class="fi-block fi-cabina">
      <h3>{T.whyH}</h3>
      <div class="fi-chips" role="group" aria-label={T.whyLabel}>
        {T.why.map((w) => <button type="button" data-why={w} aria-pressed="false">{w}</button>)}
      </div>
      <p class="fi-msg" data-why-msg data-msg={T.whyMsg} aria-live="polite"></p>
    </section>
  )}

  <footer class="fi-foot">
    <span set:html={langs} />
    <span>{T.by}</span>
  </footer>
</article>

<style>
  .ficha { background: #fff; color: var(--tinta); font-size: .9rem; line-height: 1.4; width: 100%; }
  .fi-img { position: relative; background: linear-gradient(180deg, #EEF1F5, #E4E8EE); aspect-ratio: 1 / .82; display: grid; place-items: center; overflow: hidden; }
  .fi-img img { width: 82%; height: auto; filter: drop-shadow(0 18px 18px rgba(18,38,63,.18)); }
  .fi-brand { position: absolute; top: .8rem; left: .9rem; font: 500 .95rem/1 var(--serif); color: var(--on-light); letter-spacing: .01em; }
  .fi-nfc { position: absolute; bottom: .7rem; left: .8rem; display: inline-flex; align-items: center; gap: .3rem; font-size: .72rem; font-weight: 600; color: var(--on-light); background: rgba(255,255,255,.85); backdrop-filter: blur(6px); padding: .3rem .55rem; border-radius: 999px; }
  .fi-head { padding: 1rem 1.1rem .9rem; }
  .fi-name { font: 400 1.45rem/1.1 var(--serif); font-variation-settings: 'opsz' 48; color: var(--on-light); margin: 0; letter-spacing: -0.01em; }
  .fi-meta { display: flex; justify-content: space-between; margin: .35rem 0 .8rem; color: var(--tinta-2); font-size: .82rem; }
  .fi-meta span:first-child { color: var(--tinta); font-weight: 600; font-size: .95rem; }
  .fi-tags { list-style: none; display: flex; flex-wrap: wrap; gap: .35rem; margin: 0; padding: 0; }
  .fi-tags li { font-size: .72rem; font-weight: 600; color: var(--on-light); background: #EAF0F7; padding: .3rem .55rem; border-radius: 999px; }
  .fi-block { padding: .95rem 1.1rem; border-top: 8px solid #F3F4F6; }
  .fi-block h3 { font: 600 .86rem/1.3 var(--sans); color: var(--tinta); margin: 0 0 .7rem; letter-spacing: 0; }
  .fi-cab-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: .7rem; }
  .fi-cab-head h3 { margin: 0; }
  .fi-badge { font-size: .7rem; font-weight: 700; color: #fff; background: var(--deep); padding: .25rem .5rem; border-radius: 999px; }
  .fi-sizes { display: grid; grid-template-columns: repeat(4, 1fr); gap: .4rem; }
  .fi-sizes button { position: relative; font: 600 .95rem/1 var(--sans); height: 2.8rem; border-radius: 10px; border: 1.5px solid #D5DBE3; background: #fff; color: var(--tinta); cursor: pointer; display: grid; place-content: center; gap: .15rem; }
  .fi-sizes button.cur { border-color: var(--on-light); }
  .fi-sizes button.cur::after { content: 'la tuya'; position: absolute; top: -.55rem; left: 50%; transform: translateX(-50%); font-size: .58rem; font-weight: 700; background: var(--on-light); color: #fff; padding: .1rem .35rem; border-radius: 999px; }
  .fi-sizes button.out { border-style: dashed; color: var(--tinta-2); }
  .fi-sizes small { font-size: .58rem; font-weight: 600; color: var(--deep); }
  .fi-sizes button[aria-pressed='true'] { background: var(--on-light); color: #fff; border-color: var(--on-light); }
  .fi-sizes button[aria-pressed='true'] small { color: #fff; }
  .fi-chain { list-style: none; margin: 0; padding: 0; position: relative; }
  .fi-chain::before { content: ''; position: absolute; left: 5px; top: 8px; bottom: 8px; width: 2px; background: linear-gradient(var(--deep), var(--on-light)); border-radius: 2px; }
  .fi-chain li { position: relative; display: grid; grid-template-columns: 1fr auto; padding: 0 0 .75rem 1.4rem; }
  .fi-chain li:last-child { padding-bottom: 0; }
  .fi-chain .dot { position: absolute; left: 0; top: .2rem; width: 12px; height: 12px; border-radius: 50%; background: #fff; border: 2.5px solid var(--deep); }
  .fi-chain li:last-child .dot { border-color: var(--on-light); background: var(--on-light); }
  .fi-chain b { grid-column: 1 / -1; font-size: .7rem; font-weight: 600; color: var(--tinta-2); }
  .fi-chain span { font-weight: 600; }
  .fi-chain em { font-style: normal; color: var(--tinta-2); font-size: .8rem; text-align: right; }
  .fi-care { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: .3rem; text-align: center; font-size: .68rem; color: var(--tinta-2); }
  .fi-care svg { width: 34px; height: 28px; margin: 0 auto .3rem; color: var(--on-light); }
  .fi-chips { display: flex; flex-wrap: wrap; gap: .4rem; }
  .fi-chips button { font: 600 .82rem/1 var(--sans); padding: .6rem .8rem; border-radius: 999px; border: 1.5px solid #D5DBE3; background: #fff; color: var(--tinta); cursor: pointer; }
  .fi-chips button[aria-pressed='true'] { background: var(--deep); color: #fff; border-color: var(--deep); }
  .fi-msg { min-height: 1.2em; margin: .55rem 0 0; font-size: .78rem; color: var(--deep); font-weight: 500; }
  .fi-msg:empty { display: none; }
  .fi-foot { display: flex; justify-content: space-between; padding: .8rem 1.1rem 1rem; font-size: .7rem; color: var(--tinta-2); border-top: 8px solid #F3F4F6; }
  .fi-foot b { color: var(--on-light); }
  :global(.en-casa) .fi-cabina { display: none; }
  button:focus-visible { outline: 2px solid var(--deep); outline-offset: 2px; }
</style>
