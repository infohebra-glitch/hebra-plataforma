---
// La ficha que se abre al tocar la prenda con el móvil. Ejemplo ilustrativo.
interface Props { compact?: boolean; interactive?: boolean }
const { compact = false, interactive = true } = Astro.props;
const sizes = ['S', 'M', 'L', 'XL'];
const why = ['Talla', 'Corte', 'Precio', 'Color', 'Calidad'];
---
<article class:list={['ficha', { compact }]} data-ficha={interactive ? '' : undefined}>
  <header class="fi-head">
    <p class="fi-brand">Tu marca</p>
    <h2 class="fi-name">Camisa de lino lavado</h2>
    <p class="fi-meta">Talla M · 69 €</p>
  </header>

  <section class="fi-block">
    <h3>Composición y cuidado</h3>
    <p>Lino 100 %. Lavar a 30°, sin secadora, planchar del revés.</p>
  </section>

  <section class="fi-block">
    <h3>De dónde viene</h3>
    <ol class="fi-chain">
      <li><b>Fibra</b> Lino de Normandía, Francia</li>
      <li><b>Hilado y tejido</b> Biella, Italia</li>
      <li><b>Tinte y acabado</b> Biella, Italia</li>
      <li><b>Confección</b> Guimarães, Portugal</li>
    </ol>
  </section>

  {!compact && (
    <>
      <section class="fi-block fi-cabina">
        <h3>¿Quieres otra talla?</h3>
        <div class="fi-chips" role="group" aria-label="Elegir talla">
          {sizes.map((s) => <button type="button" data-size={s} aria-pressed="false">{s}</button>)}
        </div>
        <p class="fi-msg" data-size-msg aria-live="polite"></p>
      </section>

      <section class="fi-block fi-cabina">
        <h3>¿No te la llevas? Dinos por qué</h3>
        <div class="fi-chips" role="group" aria-label="Motivo">
          {why.map((w) => <button type="button" data-why={w} aria-pressed="false">{w}</button>)}
        </div>
        <p class="fi-msg" data-why-msg aria-live="polite"></p>
      </section>
    </>
  )}
  <footer class="fi-foot">Ficha con Hebra · sin app, sin registro</footer>
</article>

<style>
  .ficha { background: #fff; color: var(--tinta); border-radius: 22px; padding: 1.4rem 1.3rem 1rem; box-shadow: 0 1px 0 var(--linea), 0 24px 48px -28px rgba(18,38,63,.45); font-size: .95rem; line-height: 1.45; max-width: 360px; }
  .fi-brand { font-size: .8rem; color: var(--tinta-2); margin: 0 0 .3rem; }
  .fi-name { font: 400 1.55rem/1.1 var(--serif); font-variation-settings: 'opsz' 48; color: var(--blau); margin: 0; letter-spacing: -0.01em; }
  .fi-meta { margin: .35rem 0 0; color: var(--tinta-2); }
  .fi-block { padding: 1rem 0; border-top: 1px solid var(--linea); }
  .fi-head { padding-bottom: 1rem; }
  .fi-block h3 { font: 600 .9rem/1.3 var(--sans); color: var(--blau); margin: 0 0 .45rem; letter-spacing: 0; }
  .fi-block p { margin: 0; }
  .fi-chain { list-style: none; margin: 0; padding: 0 0 0 1rem; border-left: 2px solid var(--grana); display: grid; gap: .5rem; }
  .fi-chain b { display: block; font-weight: 600; font-size: .78rem; color: var(--tinta-2); }
  .fi-chips { display: flex; flex-wrap: wrap; gap: .45rem; }
  .fi-chips button { font: 600 .88rem/1 var(--sans); padding: .6rem .85rem; min-width: 2.8rem; border-radius: 999px; border: 1.5px solid var(--blau); background: #fff; color: var(--blau); cursor: pointer; }
  .fi-chips button[aria-pressed='true'] { background: var(--blau); color: #fff; }
  .fi-msg { min-height: 1.3em; margin-top: .55rem !important; font-size: .85rem; color: var(--grana); }
  .fi-foot { font-size: .75rem; color: var(--tinta-2); padding-top: .8rem; border-top: 1px solid var(--linea); }
  :global(.en-casa) .fi-cabina { display: none; }
  .compact { font-size: .88rem; }
</style>
