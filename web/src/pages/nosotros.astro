---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
// Fotos del equipo: pendientes. Cuando lleguen, ponerlas en public/img/equipo/ y rellenar `foto`.
const team = [
  { name: 'Iscle', role: 'Cofundador y CEO', text: 'Dirección, marketing y ventas.', foto: '' },
  { name: 'Guillem', role: 'Cofundador, negocio', text: 'Ventas y desarrollo de negocio.', foto: '' },
];
---
<Base title="Nosotros" current="/nosotros/" description="Hebra nace en Barcelona para que las marcas de moda con tienda propia sepan qué pasa en su probador y de dónde viene lo que venden.">
  <header class="page-head">
    <div class="wrap">
      <p class="crumb"><a href="/">Inicio</a> / Nosotros</p>
      <h1>La prenda ya sabe dónde ha estado. Nosotros hacemos que la marca lo sepa.</h1>
    </div>
  </header>

  <section class="band perla">
    <div class="wrap split">
      <h2 data-reveal>Por qué existe Hebra.</h2>
      <div data-reveal>
        <p class="lead">Las grandes cadenas llevan años con etiquetas RFID para controlar su stock. Las marcas pequeñas, con una a cinco tiendas, se quedaron fuera: demasiado caro, demasiado complejo y pensado para contar cajas, no para entender a quien se prueba la ropa.</p>
        <p>Hebra nace en Barcelona para darles lo que nadie les da: saber qué pasa dentro de su probador y si contar el origen de lo que venden les hace vender más. Con hardware que ya existe, sin cámaras, y con una acción concreta cada semana.</p>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2 data-reveal>El equipo.</h2>
      <div class="team">
        {team.map((t) => (
          <article class="person" data-reveal>
            <figure class="photo" style="--ar: 4/5">
              {t.foto ? <img src={t.foto} alt={`${t.name}, ${t.role}`} loading="lazy" /> : <figcaption>Foto pendiente: retrato de {t.name}</figcaption>}
            </figure>
            <h3>{t.name}</h3>
            <p class="role">{t.role}</p>
            <p class="quiet">{t.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band blau">
    <div class="wrap split">
      <h2 data-reveal>Lo que no hacemos.</h2>
      <ul class="rows stack" data-reveal>
        <li><p>Cámaras, biometría ni seguimiento de personas.</p></li>
        <li><p>Ningún dato personal del cliente.</p></li>
        <li><p>Medir al personal de la tienda.</p></li>
        <li><p>Fabricar hardware: usamos lectores de otros, con marcado CE.</p></li>
        <li><p>Inventario de toda la tienda, caja ni antirrobo.</p></li>
        <li><p>Auditar fábricas: mostramos lo que declaran la marca y el proveedor, con certificados vigentes y diciendo de dónde sale cada dato.</p></li>
        <li><p>Prometer porcentajes de mejora antes de medirlos.</p></li>
      </ul>
    </div>
  </section>

  <section class="band perla tight">
    <div class="wrap split">
      <h2 data-reveal>Inversores, prensa y aceleradoras.</h2>
      <div data-reveal>
        <p class="lead">Te enviamos el dossier con la tesis, el modelo y el estado del proyecto.</p>
        <div class="actions"><a class="btn" href="/contacto/?motivo=dossier">Pedir el dossier</a></div>
      </div>
    </div>
  </section>

  <Cta />
</Base>

<style>
  .team { display: grid; gap: 2.5rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr)); margin-top: 2.5rem; max-width: 56rem; }
  .person h3 { margin: 1.1rem 0 .1rem; font-size: var(--step-2); font-weight: 340; font-variation-settings: 'opsz' 96; }
  .person .role { margin: 0 0 .4rem; font-weight: 600; color: var(--blau); }
  .band.blau .rows p { color: var(--blanc); }
</style>
