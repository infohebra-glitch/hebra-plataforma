---
import Base from '../layouts/Base.astro';
import Phone from '../components/Phone.astro';
import Cta from '../components/Cta.astro';
const sees = [
  { n: '01', t: 'Qué es y cómo cuidarla', d: 'Composición, cuidado con sus símbolos y el precio, en el idioma del móvil. Sin descargar nada.' },
  { n: '02', t: 'De dónde viene', d: 'Fibra, tejido, tinte y confección, con el lugar de cada etapa. Lo que la marca sabe, contado en claro.' },
  { n: '03', t: 'Otra talla sin salir', d: 'Dentro de la cabina pide la talla que le falta. La tienda recibe el aviso al momento.' },
  { n: '04', t: 'Por qué no se la lleva', d: 'Un toque: talla, corte, precio, color o calidad. Sin datos personales, solo el motivo.' },
];
const gets = [
  ['Prueba sin venta', 'Qué prendas se prueban mucho y se venden poco, por modelo, talla y color.'],
  ['Tallas que faltan', 'Las tallas pedidas desde la cabina, también las que no había en tienda.'],
  ['El porqué', 'Los motivos del «no» agrupados por prenda, para decidir si es el corte, el precio o la curva de tallas.'],
  ['Interés por el origen', 'Cuánta gente abre la cadena y si eso cambia lo que compra.'],
];
---
<Base title="La ficha" current="/ficha/" dark description="La ficha que se abre al tocar una prenda con el móvil: composición, cuidado y origen para tu cliente, y lo que pasa en el probador para ti. Sin app.">
  <section class="fx-hero">
    <div class="wrap fx-grid">
      <div class="fx-copy">
        <p class="crumb"><a href="/">Inicio</a> / La ficha</p>
        <h1 data-split>Toca la prenda. Se abre su historia.</h1>
        <p class="lead">Tu cliente acerca el móvil a la etiqueta y aparece una ficha con tu marca. Sin app, sin QR, en su idioma. Y lo que hace en ella te dice qué pasa en tu probador.</p>
        <div class="fx-mode" role="group" aria-label="Dónde está tu cliente" data-mode>
          <button type="button" data-value="cabina" aria-pressed="true">En la cabina</button>
          <button type="button" data-value="casa" aria-pressed="false">En casa</button>
        </div>
        <p class="fx-mode-text" data-mode-text="cabina">En la cabina la ficha suma dos cosas: pedir otra talla y decir por qué no se la lleva.</p>
        <p class="fx-mode-text" data-mode-text="casa" hidden>En casa queda lo esencial: composición, cuidado y origen. La etiqueta sigue funcionando toda la vida de la prenda.</p>
        <p class="small fx-try">Desliza dentro del móvil y toca las tallas.</p>
      </div>
      <div class="fx-phone" data-mode-target>
        <div class="fx-glow" aria-hidden="true"></div>
        <Phone compact={false} interactive />
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2 class="fx-h" data-reveal>Lo que ve tu cliente</h2>
      <ol class="fx-cards">
        {sees.map((s) => (
          <li data-reveal><span class="fx-n">{s.n}</span><h3>{s.t}</h3><p>{s.d}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="band blau">
    <div class="wrap split">
      <div data-reveal>
        <h2>Lo que recibes tú</h2>
        <p class="lead fx-lead">Cada toque es un dato de tu tienda física, el que la caja no ve. Lo recibes cada lunes, por tienda y por prenda.</p>
        <a class="textlink" href="/probador/">Cómo lo usamos en el probador</a>
      </div>
      <ul class="rows" data-reveal>
        {gets.map(([t, d]) => <li><h3>{t}</h3><p>{d}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="band perla tight">
    <div class="wrap fx-specs">
      <div data-reveal><h3>Sin app</h3><p>Funciona con el NFC de cualquier móvil reciente, iPhone o Android.</p></div>
      <div data-reveal><h3>Con tu marca</h3><p>Tus colores, tu tipografía y tus fotos. Hebra solo firma al pie.</p></div>
      <div data-reveal><h3>En su idioma</h3><p>Castellano, catalán, francés e inglés, según el móvil de quien la toca.</p></div>
      <div data-reveal><h3>Para toda su vida</h3><p>La misma etiqueta sirve en tienda, en casa y para el futuro pasaporte digital de producto europeo.</p></div>
    </div>
  </section>

  <Cta />
</Base>

<style>
  .fx-hero { position: relative; background: radial-gradient(70% 80% at 72% 40%, #1e5a9c 0%, var(--blau) 64%); color: var(--blanc); padding: calc(76px + clamp(2rem, 5vw, 4rem)) 0 clamp(4rem, 8vw, 6rem); overflow: hidden; }
  .fx-grid { display: grid; gap: 3rem; align-items: center; }
  @media (min-width: 960px) { .fx-grid { grid-template-columns: 1.1fr .9fr; } }
  .fx-copy h1 { color: var(--blanc); font-size: clamp(2.6rem, 1.6rem + 3.6vw, 4.8rem); max-width: 12ch; }
  .fx-copy .lead { color: #DCE4EE; max-width: 34rem; }
  .fx-hero .crumb, .fx-hero .crumb a { color: #C9D3E0; }
  .fx-mode { display: inline-flex; margin-top: 2rem; padding: 4px; border-radius: 999px; background: rgba(249,249,249,.1); box-shadow: inset 0 0 0 1px rgba(249,249,249,.2); }
  .fx-mode button { font: 600 .95rem/1 var(--sans); padding: .8rem 1.3rem; border-radius: 999px; border: 0; background: transparent; color: #DCE4EE; cursor: pointer; transition: background .25s, color .25s; }
  .fx-mode button[aria-pressed='true'] { background: var(--blanc); color: var(--blau); }
  .fx-mode button:focus-visible { outline: 2px solid #E4B3C1; outline-offset: 2px; }
  .fx-mode-text { color: #DCE4EE; margin: 1rem 0 0; max-width: 30rem; min-height: 3em; }
  .fx-try { color: #A9B8CB; margin-top: 1.5rem; }
  .fx-phone { position: relative; width: min(340px, 82vw); justify-self: center; }
  .fx-glow { position: absolute; inset: 10% -30%; background: radial-gradient(closest-side, rgba(228,179,193,.28), transparent); filter: blur(30px); pointer-events: none; }
  .fx-phone :global(.phone) { transform: rotate(-3deg); transition: transform .6s cubic-bezier(.2,.7,.2,1); }
  .fx-phone:hover :global(.phone) { transform: rotate(0); }

  .fx-h { margin-bottom: 2.5rem; }
  .fx-cards { list-style: none; margin: 0; padding: 0; display: grid; gap: 1px; background: var(--linea); border: 1px solid var(--linea); border-radius: 18px; overflow: hidden; }
  @media (min-width: 720px) { .fx-cards { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .fx-cards { grid-template-columns: repeat(4, 1fr); } }
  .fx-cards li { background: var(--blanc); padding: 2rem 1.6rem 2.2rem; }
  .fx-n { display: block; font: 400 2.4rem/1 var(--serif); color: var(--grana); margin-bottom: 1.6rem; }
  .fx-cards h3 { margin: 0 0 .5rem; }
  .fx-cards p { margin: 0; color: var(--tinta-2); }
  .fx-lead { color: #DCE4EE; }
  .fx-specs { display: grid; gap: 2rem; }
  @media (min-width: 720px) { .fx-specs { grid-template-columns: repeat(4, 1fr); } }
  .fx-specs h3 { margin: 0 0 .4rem; }
  .fx-specs p { margin: 0; color: var(--tinta-2); font-size: var(--step--1); }
  @media (max-width: 959px) { .fx-phone :global(.phone) { transform: none; } }
</style>
