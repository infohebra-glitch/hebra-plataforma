---
import '../styles/global.css';
import { ui, path, langs, langShort, langName, contacts, type Lang } from '../i18n';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  route?: string; // ruta sin idioma, p. ej. '/probador/', para enlazar las otras versiones
  current?: string;
  bare?: boolean; // ficha NFC: sin cabecera ni pie de la web
  dark?: boolean; // la página empieza sobre fondo azul
}
const { title, description, lang = 'es', route = '/', current = route, bare = false, dark = false } = Astro.props;
const t = ui[lang];
const nav = t.nav.map(([href, label]) => ({ route: href, href: path(lang, href), label }));
const fullTitle = title === 'Hebra' ? t.titleHome : `${title} · Hebra`;
const canonical = new URL(path(lang, route), Astro.site);
const locale = { es: 'es_ES', ca: 'ca_ES', en: 'en_GB' }[lang];
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(path(l, route), Astro.site)} />)}
  <link rel="icon" href="/favicon.png" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content={{ es: '#07121F', ca: '#160810', en: '#121110' }[lang]} />
  <!-- Quitar al lanzar con el dominio definitivo -->
  <meta name="robots" content="noindex" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:locale" content={locale} />
  <script is:inline>document.documentElement.classList.add('js');</script>
</head>
<body class={bare ? 'bare' : ''}>
  {!bare && (
    <>
      <div class="progress" data-progress aria-hidden="true"><i></i></div>
      <a class="brand-fixed" href={path(lang, '/')} aria-label={`Hebra, ${t.home}`}>
        <img src="/img/logo-blanc.png" alt="" width="20" height="29" />
      </a>
      <div class="top-right">
        <span class="top-langs" aria-label={t.langLabel}>
          {langs.map((l) => (
            <a href={path(l, route)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined} title={langName[l]}>{langShort[l]}</a>
          ))}
        </span>
        <a class="cta-fixed" href={path(lang, '/contacto/?motivo=demo')} data-magnetic>{t.demo}</a>
      </div>
      <nav class="dock" aria-label={t.navMain} data-dock>
        <a class="dock-word" href={path(lang, '/')}>Hebra<sup>®</sup></a>
        <ul class="dock-links">
          {nav.map((n) => (
            <li><a href={n.href} aria-current={current === n.route || (n.route !== '/' && current.startsWith(n.route)) ? 'page' : undefined}>{n.label}</a></li>
          ))}
        </ul>
        <span class="dock-langs" aria-label={t.langLabel}>
          {langs.map((l) => (
            <a href={path(l, route)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined} title={langName[l]}>{langShort[l]}</a>
          ))}
        </span>
        <button class="dock-menu" type="button" aria-expanded="false" aria-controls="overlay" data-menu data-close={t.close}>{t.menu}</button>
      </nav>
      <div class="overlay" id="overlay" data-overlay hidden>
        <ul>
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><a href={path(lang, '/contacto/')}>{t.contact}</a></li>
        </ul>
        <div class="overlay-foot">
          <span class="dock-langs">{langs.map((l) => <a href={path(l, route)} hreflang={l} aria-current={l === lang ? 'true' : undefined}>{langName[l]}</a>)}</span>
          <a class="btn" href={path(lang, '/contacto/?motivo=demo')}>{t.demo}</a>
        </div>
      </div>
      <div class="cursor" aria-hidden="true" data-cursor><span></span></div>
    </>
  )}
  <main id="main"><slot /></main>
  {!bare && (
    <footer class="foot">
      <div class="wrap">
        <div class="foot-grid">
          <nav aria-label={t.navFoot}>
            <ul>
              {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
              <li><a href={path(lang, '/piloto/')}>{t.pilot}</a></li>
              <li><a href={path(lang, '/contacto/')}>{t.contact}</a></li>
            </ul>
            <ul>
              {contacts.map((c) => <li><a href={`mailto:${c.email}`}>{c.email}</a></li>)}
              <li><a href="https://www.instagram.com/hebra.trace/" rel="noopener">Instagram</a></li>
              <li><a href="https://www.tiktok.com/@hebra.trace" rel="noopener">TikTok</a></li>
              <li><a href={path(lang, '/p/demo/')}>{t.fichaDemo}</a></li>
            </ul>
          </nav>
          <p class="foot-claim">{t.footClaim}</p>
        </div>
        <p class="foot-word" aria-hidden="true">Hebra</p>
        <p class="foot-base"><span>{t.base}</span><span class="foot-legal"><a href={path(lang, '/privacidad/')}>{t.privacy}</a><a href={path(lang, '/aviso-legal/')}>{t.legal}</a><a href={path(lang, '/cookies/')}>{t.cookies}</a></span></p>
      </div>
    </footer>
  )}
  <script>
    import '../scripts/motion.js';
  </script>
</body>
</html>

<style is:global>
  .progress { position: fixed; inset: 0 0 auto; height: 3px; z-index: 80; cursor: pointer; }
  .progress i { display: block; height: 100%; background: var(--tint); transform-origin: left; transform: scaleX(0); }
  .brand-fixed { position: fixed; top: 1.4rem; left: var(--gutter); z-index: 60; mix-blend-mode: difference; }
  .brand-fixed img { height: 30px; width: auto; }
  .top-right { position: fixed; top: 1.1rem; right: var(--gutter); z-index: 60; display: flex; align-items: center; gap: 1rem; }
  .top-langs { display: flex; gap: .2rem; padding: .3rem; border-radius: 999px; background: color-mix(in srgb, var(--ink) 55%, transparent); border: 1px solid var(--rule-dark); backdrop-filter: blur(10px); }
  .top-langs a { font: 600 .74rem/1 var(--sans); letter-spacing: .02em; color: var(--on-dark-2); text-decoration: none; padding: .5rem .6rem; border-radius: 999px; transition: color .3s, background .3s; }
  .top-langs a:hover { color: var(--on-dark); }
  .top-langs a[aria-current] { background: var(--on-dark); color: var(--ink); }
  .cta-fixed { padding: .75em 1.3em; border-radius: 999px; font: 560 .92rem/1 var(--sans); text-decoration: none; color: var(--ink); background: var(--on-dark); transition: background .4s var(--ease); }
  .cta-fixed:hover { background: var(--tint); }

  /* La barra viaja: empieza arriba, baja con el scroll y se queda abajo en el centro */
  .dock { position: fixed; left: 50%; bottom: 1.4vh; z-index: 70; display: flex; align-items: center; gap: 2rem; padding: .7rem 1.1rem .7rem 1.3rem; translate: -50% 0; color: #fff; mix-blend-mode: difference; font-size: .9rem; white-space: nowrap; }
  .dock a { text-decoration: none; }
  .dock-word { font-weight: 640; letter-spacing: -0.04em; font-size: 1.02rem; }
  .dock-word sup { font-size: .5em; font-weight: 400; margin-left: 1px; }
  .dock-links { display: flex; gap: 1.5rem; list-style: none; margin: 0; padding: 0; }
  .dock-links a { position: relative; opacity: .82; transition: opacity .3s; }
  .dock-links a:hover, .dock-links a[aria-current] { opacity: 1; }
  .dock-links a::after { content: ''; position: absolute; left: 0; right: 0; bottom: -4px; height: 1px; background: currentColor; transform: scaleX(0); transform-origin: right; transition: transform .5s var(--ease); }
  .dock-links a:hover::after, .dock-links a[aria-current]::after { transform: scaleX(1); transform-origin: left; }
  .dock-langs { display: flex; gap: .7rem; font-size: .78rem; }
  .dock > .dock-langs { display: none; }
  .dock-langs a { opacity: .55; }
  .dock-langs a[aria-current], .dock-langs a:hover { opacity: 1; }
  .dock-menu { display: none; background: none; border: 0; color: inherit; font: 560 .92rem/1 var(--sans); cursor: pointer; padding: .3rem 0; }
  @media (max-width: 1100px) {
    .dock { gap: 1.6rem; padding: .75rem 1.3rem; mix-blend-mode: normal; color: var(--on-dark); background: color-mix(in srgb, var(--ink) 78%, transparent); border: 1px solid var(--rule-dark); border-radius: 999px; backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); }
    .dock-links, .dock > .dock-langs { display: none; }
    .dock-menu { display: block; }
  }
  @media (max-width: 520px) { .cta-fixed { font-size: .8rem; padding: .7em 1em; } .top-right { gap: .5rem; } .top-langs a { padding: .45rem .5rem; } }

  .overlay { position: fixed; inset: 0; z-index: 65; background: var(--ink); color: var(--on-dark); display: grid; align-content: center; padding: 6rem var(--gutter) 7rem; }
  .overlay ul { list-style: none; margin: 0; padding: 0; }
  .overlay li a { display: block; padding: .5rem 0; font: 420 clamp(2.2rem, 9vw, 4rem)/1.05 var(--sans); letter-spacing: -0.05em; text-decoration: none; }
  .overlay li a:hover { font-family: var(--serif); font-style: italic; font-weight: 300; }
  .overlay-foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1.5rem; margin-top: 3rem; }
  .overlay .dock-langs { font-size: .95rem; gap: 1.2rem; }
  .overlay .btn { background: var(--on-dark); color: var(--ink); border-color: var(--on-dark); }

  .cursor { position: fixed; left: 0; top: 0; z-index: 90; pointer-events: none; width: 0; height: 0; }
  .cursor span { position: absolute; left: -9px; top: -9px; width: 18px; height: 18px; border-radius: 50%; border: 1.5px solid #fff; box-shadow: 0 0 0 1px rgba(0,0,0,.18), inset 0 0 0 1px rgba(0,0,0,.12); display: grid; place-items: center; font: 600 .7rem/1 var(--sans); color: var(--ink); transition: width .35s var(--ease), height .35s var(--ease), left .35s var(--ease), top .35s var(--ease), background .35s, transform .2s var(--ease), opacity .3s; opacity: 0; }
  .cursor.on span { opacity: 1; }
  .cursor.link span { width: 34px; height: 34px; left: -17px; top: -17px; background: rgba(255,255,255,.18); backdrop-filter: blur(2px); }
  .cursor.label span { width: 72px; height: 72px; left: -36px; top: -36px; background: #fff; border-color: #fff; }
  .cursor.down span { transform: scale(.6); }
  @media (hover: none), (max-width: 860px) { .cursor { display: none; } }

  .foot { background: var(--ink); color: var(--on-dark); padding: clamp(4rem, 8vw, 6rem) 0 calc(5.5rem + 2vh); overflow: hidden; }
  .foot-grid { display: grid; gap: 3rem; }
  @media (min-width: 860px) { .foot-grid { grid-template-columns: 1fr 1fr; align-items: end; } }
  .foot-claim { font: 300 italic var(--step-2)/1.15 var(--serif); font-variation-settings: 'opsz' 144, 'SOFT' 100; letter-spacing: -0.03em; color: var(--on-dark); max-width: 22ch; margin: 0; justify-self: end; }
  .foot nav { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; font-size: .95rem; }
  .foot nav ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .55rem; align-content: start; }
  .foot nav a { text-decoration: none; color: var(--on-dark-2); transition: color .3s; }
  .foot nav a:hover { color: var(--on-dark); }
  .foot-word { margin: clamp(3rem, 7vw, 6rem) 0 0; font: 600 clamp(6rem, 27vw, 26rem)/.78 var(--sans); letter-spacing: -0.075em; color: var(--ink-2); max-width: none; user-select: none; }
  .foot-base { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; margin: 2rem 0 0; font-size: var(--step--1); color: var(--on-dark-2); max-width: none; }
  .foot-legal { display: flex; gap: 1.5rem; }
  .foot-legal a { text-decoration: none; }
  .foot-legal a:hover { color: var(--on-dark); }
</style>
